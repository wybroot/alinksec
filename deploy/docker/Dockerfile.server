# ALinkSec 服务端镜像
# 构建上下文 = 仓库根（docker compose 已配置）；镜像内完成 Maven 构建。
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /build
COPY server /build/server
RUN mvn -f /build/server/pom.xml -DskipTests package

FROM eclipse-temurin:21-jre-jammy

WORKDIR /app
COPY --from=build /build/server/alinksec-bootstrap/target/alinksec-bootstrap-0.1.0-SNAPSHOT.jar app.jar

# 9443 gRPC(mTLS) / 8080 REST
EXPOSE 9443 8080

# data/ 下为证书与运行状态，由 volume 持久化
VOLUME /app/data

ENTRYPOINT ["java", \
  "-XX:MaxRAMPercentage=75.0", \
  "-jar", "app.jar"]
