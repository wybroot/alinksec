# Copy to .env.lite and replace every required value before startup.
# v0.0.1 defaults to published images; overrides can pin a repository digest.
# ALINKSEC_SERVER_IMAGE=wangyanbiao/alinksec:server-v0.0.1
# ALINKSEC_WEB_IMAGE=wangyanbiao/alinksec:web-v0.0.1
# ALINKSEC_SQLITE_MAINTENANCE_IMAGE=wangyanbiao/alinksec:sqlite-maintenance-v0.0.1
HOST_IP=192.168.1.100
ALINKSEC_BIND_ADDRESS=192.168.1.100

ALINKSEC_BOOTSTRAP_ADMIN_PASSWORD=
ALINKSEC_BOOTSTRAP_ENROLL_TOKEN=
ALINKSEC_JWT_SECRET=

ALINKSEC_LEGACY_COMMAND_POLICY=report

# Optional absolute host directory used by sqlite-maintenance.sh.
# ALINKSEC_BACKUP_DIR=/srv/alinksec/backups
