# 复制为 .env 后按需修改：cp .env.example .env
# v0.0.1 defaults to wangyanbiao/alinksec component images. No local build required.
# ALINKSEC_SERVER_IMAGE=wangyanbiao/alinksec:server-v0.0.1
# ALINKSEC_WEB_IMAGE=wangyanbiao/alinksec:web-v0.0.1

# 【必改】宿主机 IP：目标主机上的 Agent 直连 <HOST_IP>:9443，服务端证书 SAN 必须包含它。
# 必须在 server 首次启动（证书生成）前配置；下方示例值会被服务端拒绝。
# 修改已签发证书的地址需按部署文档的 TLS 恢复步骤操作，旧 Agent 证书会失效。
HOST_IP=192.168.1.100

# 【必改】Docker 发布端口绑定的本机 IPv4。通常与 HOST_IP 相同；不得填写 0.0.0.0。
ALINKSEC_BIND_ADDRESS=192.168.1.100

# 首次启动凭据：请替换为高强度密码和随机 ENROLL- 前缀注册码后再执行 docker compose。
ALINKSEC_BOOTSTRAP_ADMIN_PASSWORD=
ALINKSEC_BOOTSTRAP_ENROLL_TOKEN=
ALINKSEC_POSTGRES_PASSWORD=
# 长期运行的 server 仅使用此最小权限应用账号密码，必须与上面的初始化账号密码不同。
ALINKSEC_POSTGRES_APP_PASSWORD=

# 建议使用 `openssl rand -base64 48` 生成。留空时服务端会生成并持久化到 server-data 卷；
# 多实例部署必须为所有 server 配置同一个值。
ALINKSEC_JWT_SECRET=

# 旧格式待执行命令默认只报告；确认不需要回放后可改为 fail。
ALINKSEC_LEGACY_COMMAND_POLICY=report
