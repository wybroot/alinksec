      "severity": 3,
      "check": {
        "type": "windows_security_policy",
        "target": "local-machine",
        "option": "ntlm",
        "operator": "eq",
        "expected": "LmCompatibilityLevel=5"
      },
      "remediation": "经变更审批配置本机或域策略并重新核查；同时核验域细粒度策略、实际会话与业务账户。建议阈值由项目制定，不等同于标准规定值。"
    },
    {
      "code": "MLPS-WIN-idle_timeout",
      "ruleId": "alinksec:windows:idle_timeout",
      "name": "本机交互空闲锁定声明",
      "category": "Windows 安全策略",
      "severity": 3,
      "check": {
        "type": "windows_security_policy",
        "target": "local-machine",
        "option": "idle_timeout",
        "operator": "eq",
        "expected": "InactivityTimeoutSecs=1..900"
      },
      "remediation": "经变更审批配置本机或域策略并重新核查；同时核验域细粒度策略、实际会话与业务账户。建议阈值由项目制定，不等同于标准规定值。"
    },
    {
      "code": "MLPS-WIN-smb1",
      "ruleId": "alinksec:windows:smb1",
      "name": "SMBv1 可选组件处于禁用状态",
      "category": "Windows 安全策略",
      "severity": 3,
      "check": {
        "type": "windows_security_policy",
        "target": "local-machine",
        "option": "smb1",
        "operator": "eq",
        "expected": "SMB1Protocol=Disabled|DisabledWithPayloadRemoved",
        "timeout_ms": 30000
      },
      "remediation": "经变更审批配置本机或域策略并重新核查；同时核验域细粒度策略、实际会话与业务账户。建议阈值由项目制定，不等同于标准规定值。"
    },
    {
      "code": "MLPS-ALINKSEC-WINDOWS-001",
      "ruleId": "ALINKSEC-WINDOWS-001",
      "name": "有效策略的三个防火墙配置均已启用",
      "category": "基础防护",
      "severity": 3,
      "check": {
        "type": "cmd_output",
        "cmd": "powershell.exe -NoProfile -NonInteractive -Command \"$profiles = @(Get-NetFirewallProfile -PolicyStore ActiveStore -ErrorAction Stop); if ($profiles.Count -ne 3) { throw 'Expected three firewall profiles' }; $profiles | Where-Object { -not $_.Enabled } | Measure-Object | Select-Object -ExpandProperty Count\"",
        "operator": "eq",
        "expected": "0",
        "timeout_ms": 15000
      },
      "remediation": "读取 ActiveStore 的 Domain、Private、Public 三个配置；缺失配置或查询失败是执行异常。不证明规则集允许的流量安全；由管理员核对业务规则，本包不自动修复。"
    },
    {
      "code": "MLPS-ALINKSEC-WINDOWS-002",
      "ruleId": "ALINKSEC-WINDOWS-002",
      "name": "Defender 实时保护已启用",
      "category": "基础防护",
      "severity": 3,
      "check": {
        "type": "cmd_output",
        "cmd": "powershell.exe -NoProfile -NonInteractive -Command \"Get-MpComputerStatus -ErrorAction Stop | Select-Object -ExpandProperty RealTimeProtectionEnabled\"",
        "operator": "eq",
        "expected": "True",
        "timeout_ms": 15000
      },
      "remediation": "只确认 Defender 的 RealTimeProtectionEnabled 当前值；缺少 Defender 或查询失败是执行异常。其他杀毒产品不据此判为合规；人工核对当前检测产品和更新策略，本包不自动修复。"
    },
    {
      "code": "MLPS-ALINKSEC-WINDOWS-003",
      "ruleId": "ALINKSEC-WINDOWS-003",
      "name": "事件日志服务运行",
      "category": "基础防护",
      "severity": 3,
      "check": {
        "type": "cmd_output",
        "cmd": "powershell.exe -NoProfile -NonInteractive -Command \"Get-Service -Name EventLog -ErrorAction Stop | Select-Object -ExpandProperty Status\"",
        "operator": "eq",
        "expected": "Running",
        "timeout_ms": 15000
      },
      "remediation": "只确认 EventLog 服务当前状态为 Running；不证明日志保留、审计策略、完整性或集中传输。由管理员审查日志策略，本包不自动修复。"
    },
    {
      "code": "MLPS-ALINKSEC-WINDOWS-004",
      "ruleId": "ALINKSEC-WINDOWS-004",
      "name": "用户账户控制已启用",
      "category": "基础防护",
      "severity": 3,
      "check": {
        "type": "cmd_output",
        "cmd": "powershell.exe -NoProfile -NonInteractive -Command \"Get-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System' -Name EnableLUA -ErrorAction Stop | Select-Object -ExpandProperty EnableLUA\"",
        "operator": "eq",
        "expected": "1",
        "timeout_ms": 15000
      },
      "remediation": "只确认 EnableLUA 注册表配置为 1；不证明所有 UAC 提示或重启后的生效状态。按 Microsoft 的 UAC 策略核对，本包不自动修复。"
    }
  ],
