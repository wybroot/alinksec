    {
      "code": "MLPS-WIN-rdp_nla",
      "ruleId": "alinksec:windows:rdp_nla",
      "name": "RDP 网络级身份验证声明",
      "category": "Windows 安全策略",
      "severity": 3,
      "check": {
        "type": "windows_security_policy",
        "target": "local-machine",
        "option": "rdp_nla",
        "operator": "eq",
        "expected": "UserAuthentication=1"
      },
      "remediation": "经变更审批配置本机或域策略并重新核查；同时核验域细粒度策略、实际会话与业务账户。建议阈值由项目制定，不等同于标准规定值。"
    },
    {
      "code": "MLPS-WIN-rdp_tls",
      "ruleId": "alinksec:windows:rdp_tls",
      "name": "RDP TLS 与加密强度声明",
      "category": "Windows 安全策略",
      "severity": 3,
      "check": {
        "type": "windows_security_policy",
        "target": "local-machine",
        "option": "rdp_tls",
        "operator": "eq",
        "expected": "SecurityLayer=2,MinEncryptionLevel>=3"
      },
      "remediation": "经变更审批配置本机或域策略并重新核查；同时核验域细粒度策略、实际会话与业务账户。建议阈值由项目制定，不等同于标准规定值。"
    },
