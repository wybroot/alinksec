{
  "schemaVersion": 2,
  "code": "ALINKSEC-MLPS2-L2-WINDOWS",
  "name": "等保 2.0 2级安全计算环境 · Windows",
  "standard": "GB/T 22239-2019",
  "product": "Windows 10/11、Server 2019/2022/2025",
  "osType": 2,
  "osVersionPattern": "^(Microsoft )?Windows (10|11|Server (2019|2022|2025))([ .][A-Za-z0-9._ -]+)?$",
  "version": "1.0.0",
  "source": {
    "name": "AlinkSec reviewed MLPS host evidence definitions",
    "version": "1.0.0",
    "url": "https://github.com/wybroot/alinksec/tree/main/deploy/baseline/compliance",
    "sha256": "39fbff6e0a7ac5ae3ba8101f8341bc60e1e9670996beb8dbe33ea3f46d183258"
  },
  "items": [
    {
      "code": "MLPS-WIN-password_length",
      "ruleId": "alinksec:windows:password_length",
      "name": "本机口令最小长度",
      "category": "Windows 安全策略",
      "severity": 3,
      "check": {
        "type": "windows_security_policy",
        "target": "local-machine",
        "option": "password_length",
        "operator": "eq",
        "expected": "minimum_length>=12"
      },
      "remediation": "经变更审批配置本机或域策略并重新核查；同时核验域细粒度策略、实际会话与业务账户。建议阈值由项目制定，不等同于标准规定值。"
    },
    {
      "code": "MLPS-WIN-password_age",
      "ruleId": "alinksec:windows:password_age",
      "name": "本机口令有效期与最短修改间隔",
      "category": "Windows 安全策略",
      "severity": 3,
      "check": {
        "type": "windows_security_policy",
        "target": "local-machine",
        "option": "password_age",
        "operator": "eq",
        "expected": "maximum_age=1..90d,minimum_age=1..maximum_age"
      },
      "remediation": "经变更审批配置本机或域策略并重新核查；同时核验域细粒度策略、实际会话与业务账户。建议阈值由项目制定，不等同于标准规定值。"
    },
