{
  "schemaVersion": 1,
  "source": {
    "name": "ALinkSec reviewed starter definitions",
    "version": "1",
    "url": "https://github.com/wybroot/alinksec/tree/main/deploy/baseline"
  },
  "platforms": {
    "linux": {
      "code": "ALINKSEC-LINUX-BASE",
      "name": "Linux 基础安全核查",
      "standard": "ALinkSec 基础核查（非完整合规基线）",
      "product": "linux",
      "osType": 1,
      "osVersionPattern": "^.*$",
      "version": "1",
      "items": [
        {
          "code": "ALINKSEC-LINUX-001",
          "ruleId": "ALINKSEC-LINUX-001",
          "name": "IPv4 转发关闭",
          "category": "基础防护",
          "severity": 3,
          "check": {
            "type": "cmd_output",
            "cmd": "sysctl -n net.ipv4.ip_forward",
            "operator": "eq",
            "expected": "0",
            "timeout_ms": 5000
          },
          "remediation": "人工审查后按系统和业务需要调整；本包不提供自动修复。"
        },
        {
          "code": "ALINKSEC-LINUX-002",
          "ruleId": "ALINKSEC-LINUX-002",
          "name": "TCP SYN Cookie 已启用",
          "category": "基础防护",
          "severity": 3,
          "check": {
            "type": "cmd_output",
            "cmd": "sysctl -n net.ipv4.tcp_syncookies",
            "operator": "eq",
            "expected": "1",
            "timeout_ms": 5000
          },
          "remediation": "人工审查后按系统和业务需要调整；本包不提供自动修复。"
        },
        {
          "code": "ALINKSEC-LINUX-003",
          "ruleId": "ALINKSEC-LINUX-003",
          "name": "拒绝 IPv4 重定向",
          "category": "基础防护",
          "severity": 3,
          "check": {
            "type": "cmd_output",
            "cmd": "sysctl -n net.ipv4.conf.all.accept_redirects",
            "operator": "eq",
            "expected": "0",
            "timeout_ms": 5000
          },
          "remediation": "人工审查后按系统和业务需要调整；本包不提供自动修复。"
        },
        {
          "code": "ALINKSEC-LINUX-004",
          "ruleId": "ALINKSEC-LINUX-004",
          "name": "拒绝 IPv4 源路由",
          "category": "基础防护",
          "severity": 3,
          "check": {
            "type": "cmd_output",
            "cmd": "sysctl -n net.ipv4.conf.all.accept_source_route",
            "operator": "eq",
            "expected": "0",
            "timeout_ms": 5000
          },
          "remediation": "人工审查后按系统和业务需要调整；本包不提供自动修复。"
        }
      ],
      "unsupported": []
    },
    "windows": {
      "code": "ALINKSEC-WINDOWS-BASE",
      "name": "Windows 基础安全核查",
      "standard": "ALinkSec 基础核查（非完整合规基线）",
      "product": "windows",
      "osType": 2,
      "osVersionPattern": "^.*$",
      "version": "1",
      "items": [
        {
          "code": "ALINKSEC-WINDOWS-001",
          "ruleId": "ALINKSEC-WINDOWS-001",
          "name": "所有防火墙配置已启用",
          "category": "基础防护",
          "severity": 3,
          "check": {
            "type": "cmd_output",
            "cmd": "powershell.exe -NoProfile -NonInteractive -Command \"Get-NetFirewallProfile -PolicyStore ActiveStore -ErrorAction Stop | Where-Object { -not $_.Enabled } | Measure-Object | Select-Object -ExpandProperty Count\"",
            "operator": "eq",
            "expected": "0",
            "timeout_ms": 15000
          },
          "remediation": "人工审查后按系统和业务需要调整；本包不提供自动修复。"
        },
        {
          "code": "ALINKSEC-WINDOWS-002",
          "ruleId": "ALINKSEC-WINDOWS-002",
          "name": "Defender 实时保护已启用",
          "category": "基础防护",
          "severity": 3,
          "check": {
            "type": "cmd_output",
            "cmd": "powershell.exe -NoProfile -NonInteractive -Command \"Get-MpComputerStatus -ErrorAction Stop | Select-Object -ExpandProperty RealTimeProtectionEnabled\"",
            "operator": "eq",
            "expected": "True",
            "timeout_ms": 15000
          },
          "remediation": "人工审查后按系统和业务需要调整；本包不提供自动修复。"
        },
        {
          "code": "ALINKSEC-WINDOWS-003",
          "ruleId": "ALINKSEC-WINDOWS-003",
          "name": "事件日志服务运行",
          "category": "基础防护",
          "severity": 3,
          "check": {
            "type": "cmd_output",
            "cmd": "powershell.exe -NoProfile -NonInteractive -Command \"Get-Service -Name EventLog -ErrorAction Stop | Select-Object -ExpandProperty Status\"",
            "operator": "eq",
            "expected": "Running",
            "timeout_ms": 15000
          },
          "remediation": "人工审查后按系统和业务需要调整；本包不提供自动修复。"
        },
        {
          "code": "ALINKSEC-WINDOWS-004",
          "ruleId": "ALINKSEC-WINDOWS-004",
          "name": "用户账户控制已启用",
          "category": "基础防护",
          "severity": 3,
          "check": {
            "type": "cmd_output",
            "cmd": "powershell.exe -NoProfile -NonInteractive -Command \"Get-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System' -Name EnableLUA -ErrorAction Stop | Select-Object -ExpandProperty EnableLUA\"",
            "operator": "eq",
            "expected": "1",
            "timeout_ms": 15000
          },
          "remediation": "人工审查后按系统和业务需要调整；本包不提供自动修复。"
        }
      ],
      "unsupported": []
    }
  }
}
